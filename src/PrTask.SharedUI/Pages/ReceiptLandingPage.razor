@page "/Receipt"
@using PrTask.Domain.Constants
<style>
.delivery-receipt { background: #20203a; border: 1px solid #2d2d4a; border-radius: 12px; overflow: hidden; margin-top: 1.5rem; color: #e6e6f0; }
.receipt-header { padding: 1.5rem 1.75rem 1rem; border-bottom: 1px solid #2d2d4a; background: linear-gradient(180deg, #2a2a48, #20203a); }
.receipt-header h2 { color: #fff; font-size: 1.35rem; margin: 0 0 0.3rem; }
.receipt-header p { color: #8a8aa8; margin: 0 0 1rem; }
.receipt-stamp { display: inline-block; padding: 0.25rem 0.7rem; border-radius: 4px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.7rem; background: rgba(108,142,255,0.12); color: #6c8eff; border: 1px solid rgba(108,142,255,0.4); }
.receipt-stamp-paid { background: rgba(74,222,128,0.12); color: #4ade80; border-color: rgba(74,222,128,0.4); }
.receipt-stamp-pending { background: rgba(250,204,21,0.12); color: #facc15; border-color: rgba(250,204,21,0.4); }
.receipt-id-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin-top: 0.75rem; }
.receipt-id-grid div { background: rgba(0,0,0,0.18); padding: 0.6rem 0.85rem; border-radius: 6px; }
.receipt-id-grid dt { color: #8a8aa8; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.2rem; }
.receipt-id-grid dd { margin: 0; color: #e6e6f0; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.85rem; word-break: break-all; }
.receipt-block { padding: 1.5rem 1.75rem; border-bottom: 1px solid #2d2d4a; }
.receipt-block:last-of-type { border-bottom: none; }
.receipt-block h2 { color: #fff; font-size: 1.05rem; margin: 0 0 0.6rem; }
.receipt-block p { margin: 0 0 0.6rem; color: #b8b8d4; }
.receipt-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem 1.25rem; margin: 0.5rem 0 0; }
.receipt-grid > div { padding: 0; }
.receipt-grid div.full { grid-column: 1 / -1; }
.receipt-grid dt { color: #8a8aa8; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.15rem; }
.receipt-grid dd { margin: 0; color: #e6e6f0; font-size: 0.93rem; word-break: break-word; }
.receipt-grid dd.mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.86rem; }
.delivery-receipt a { color: #6c8eff; }
.delivery-receipt a:hover { color: #9bb3ff; }
.receipt-actions { padding: 1rem 1.75rem; background: #2a2a48; display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: flex-end; }
.receipt-actions button { background: transparent; color: #e6e6f0; border: 1px solid #2d2d4a; border-radius: 6px; padding: 0.5rem 0.95rem; font-size: 0.85rem; cursor: pointer; }
.receipt-actions button:hover { border-color: #6c8eff; color: #6c8eff; }
.reviewer { display: inline-flex; align-items: center; gap: 0.4rem; background: #2a2a48; border: 1px solid #2d2d4a; padding: 0.2rem 0.55rem 0.2rem 0.3rem; border-radius: 99px; font-size: 0.82rem; margin-right: 0.4rem; }
.reviewer img { width: 18px; height: 18px; border-radius: 50%; }
.receipt-lookup { background: #20203a; border: 1px solid #2d2d4a; border-radius: 10px; padding: 1rem 1.25rem; margin: 1rem 0 1.25rem; display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: stretch; color: #e6e6f0; }
.receipt-lookup label { flex: 1 1 100%; color: #8a8aa8; font-size: 0.82rem; }
.receipt-lookup input[type=url] { flex: 1 1 380px; min-width: 0; background: #1a1a2e; color: #e6e6f0; border: 1px solid #2d2d4a; border-radius: 6px; padding: 0.6rem 0.8rem; font-size: 0.92rem; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
.receipt-lookup input[type=url]:focus { outline: none; border-color: #6c8eff; }
.receipt-lookup button { flex: 0 0 auto; background: #6c8eff; color: #0a0a18; border: none; border-radius: 6px; padding: 0.6rem 1.1rem; font-weight: 600; cursor: pointer; font-size: 0.9rem; }
.receipt-lookup button.btn-secondary { background: transparent; color: #e6e6f0; border: 1px solid #2d2d4a; }
.receipt-lookup button:hover { background: #9bb3ff; }
.receipt-lookup button.btn-secondary:hover { background: transparent; border-color: #6c8eff; color: #6c8eff; }
.receipt-lookup .hint { flex: 1 1 100%; color: #8a8aa8; font-size: 0.82rem; margin: 0.4rem 0 0; }
.receipt-lookup .hint code { background: #2a2a48; padding: 0.05rem 0.35rem; border-radius: 3px; }
.receipt-status { margin: 0 0 1rem; padding: 0.7rem 1rem; border-radius: 6px; font-size: 0.92rem; background: #1f2a3a; color: #93c5fd; border-left: 4px solid #6c8eff; }
.receipt-status.error { background: #3a1f24; color: #fca5a5; border-left-color: #f87171; }
@@media (max-width: 640px) { .receipt-id-grid, .receipt-grid { grid-template-columns: 1fr; } }
@@media print { body { background: #fff; color: #111; } .receipt-lookup, .receipt-actions, nav, footer { display: none; } .delivery-receipt { border: 1px solid #888; } .receipt-header { background: #f3f3f7; } .receipt-header h2, .receipt-block h2, .receipt-grid dd, .receipt-id-grid dd { color: #111; } .receipt-block p, .receipt-grid dt, .receipt-id-grid dt { color: #555; } a { color: #1a1a2e; } }
</style>
<h1>@ReceiptConstants.PageHeading</h1>
<p>@ReceiptConstants.PageSubtitle</p>
<form id="receipt-lookup" class="receipt-lookup">
    <label for="receipt-src">Receipt source (paste a GitHub pull request URL or a PrTask task ID)</label>
    <input type="url" id="receipt-src" name="receipt-src" placeholder="https://github.com/OWNER/REPO/pull/123" autocomplete="off" spellcheck="false" />
    <button type="submit" id="receipt-submit">Render Receipt</button>
    <button type="button" id="receipt-example" class="btn-secondary">Load example</button>
    <p class="hint">Tip: append <code>?pr=&lt;PR URL&gt;</code> or <code>?taskId=&lt;id&gt;</code> to deep-link a receipt straight from email.</p>
</form>
<div id="receipt-status" class="receipt-status" hidden></div>
<article id="receipt" class="delivery-receipt" hidden>
    <header class="receipt-header">
        <span class="receipt-stamp" id="receipt-stamp"></span>
        <h2 id="receipt-title">@ReceiptConstants.PageHeading</h2>
        <p id="receipt-subtitle">@ReceiptConstants.PageSubtitle</p>
        <dl class="receipt-id-grid">
            <div><dt>@ReceiptConstants.ReceiptNumberLabel</dt><dd id="r-receipt-number"></dd></div>
            <div><dt>@ReceiptConstants.TransactionReferenceLabel</dt><dd id="r-maya-ref"></dd></div>
            <div><dt>@ReceiptConstants.IssuedAtLabel</dt><dd id="r-issued-at"></dd></div>
        </dl>
    </header>
    <section class="receipt-block">
        <h2>@ReceiptConstants.DeliveryConfirmationHeading</h2>
        <p>@ReceiptConstants.DeliveryConfirmationBody</p>
    </section>
    <section class="receipt-block">
        <h2>Task</h2>
        <dl class="receipt-grid">
            <div><dt>@ReceiptConstants.TaskIdLabel</dt><dd class="mono" id="r-task-id"></dd></div>
            <div><dt>@ReceiptConstants.TaskTitleLabel</dt><dd id="r-task-title"></dd></div>
            <div class="full"><dt>@ReceiptConstants.TaskDescriptionLabel</dt><dd id="r-task-desc"></dd></div>
            <div><dt>@ReceiptConstants.RepositoryLabel</dt><dd id="r-repo-url"></dd></div>
            <div><dt>@ReceiptConstants.ComplexityLabel</dt><dd id="r-complexity"></dd></div>
            <div><dt>@ReceiptConstants.ClientLabel</dt><dd id="r-client"></dd></div>
            <div><dt>@ReceiptConstants.DeveloperLabel</dt><dd id="r-developer"></dd></div>
        </dl>
    </section>
    <section class="receipt-block">
        <h2>@ReceiptConstants.PullRequestLabel</h2>
        <dl class="receipt-grid">
            <div><dt>@ReceiptConstants.PullRequestLabel</dt><dd class="mono" id="r-pr-id"></dd></div>
            <div class="full"><dt>@ReceiptConstants.PullRequestUrlLabel</dt><dd id="r-pr-url"></dd></div>
            <div><dt>@ReceiptConstants.SubmittedAtLabel</dt><dd class="mono" id="r-submitted"></dd></div>
            <div><dt>@ReceiptConstants.ApprovedAtLabel</dt><dd class="mono" id="r-merged"></dd></div>
            <div><dt>@ReceiptConstants.MergeCommitShaLabel</dt><dd class="mono" id="r-sha"></dd></div>
            <div><dt>Base Branch</dt><dd class="mono" id="r-base"></dd></div>
            <div><dt>@ReceiptConstants.FilesChangedLabel</dt><dd id="r-files"></dd></div>
            <div><dt>@ReceiptConstants.LinesChangedLabel</dt><dd class="mono" id="r-lines"></dd></div>
            <div class="full"><dt>@ReceiptConstants.AcceptanceTrailHeading</dt><dd id="r-reviewers"></dd></div>
        </dl>
    </section>
    <section class="receipt-block">
        <h2>Payment</h2>
        <dl class="receipt-grid">
            <div><dt>@ReceiptConstants.AmountLabel</dt><dd class="mono" id="r-amount"></dd></div>
            <div><dt>@ReceiptConstants.PlatformFeeLabel</dt><dd class="mono" id="r-fee"></dd></div>
            <div><dt>@ReceiptConstants.NetToDeveloperLabel</dt><dd class="mono" id="r-net"></dd></div>
            <div><dt>@ReceiptConstants.CurrencyLabel</dt><dd id="r-currency">@ReceiptConstants.CurrencyPhp</dd></div>
            <div><dt>@ReceiptConstants.PaymentMethodLabel</dt><dd id="r-method">@ReceiptConstants.PaymentMethodMaya</dd></div>
            <div><dt>@ReceiptConstants.PaymentStatusLabel</dt><dd id="r-status"></dd></div>
            <div><dt>@ReceiptConstants.PaidAtLabel</dt><dd class="mono" id="r-paid"></dd></div>
        </dl>
    </section>
    <section class="receipt-block">
        <h2>@ReceiptConstants.IndependentVerificationHeading</h2>
        <p>@ReceiptConstants.IndependentVerificationBody</p>
        <p><a id="r-gh-link" href="#" target="_blank" rel="noopener" hidden>@ReceiptConstants.ActionViewOnGitHub</a></p>
    </section>
    <section class="receipt-block">
        <h2>@ReceiptConstants.RecordsRetentionHeading</h2>
        <p>@ReceiptConstants.RecordsRetentionBody</p>
    </section>
    <section class="receipt-block">
        <h2>@ReceiptConstants.ContactHeading</h2>
        <p>@ReceiptConstants.ContactBody</p>
    </section>
    <footer class="receipt-actions">
        <button type="button" id="receipt-print">@ReceiptConstants.ActionPrint</button>
        <button type="button" id="receipt-copy">@ReceiptConstants.ActionCopyJson</button>
    </footer>
</article>
<section class="page-description">
    <h2>How this template is populated</h2>
    <ol>
        <li><strong>Source-of-truth template</strong> lives at <code>src/PrTask.SharedUI/Pages/ReceiptPage.razor</code> with route <code>/receipts/&#123;TaskId&#125;</code>. The Razor component reads <code>TaskEntity</code>, <code>PullRequestEntity</code>, <code>PaymentEntity</code>, and <code>UserEntity</code> via the injected services and renders the same fields shown above.</li>
        <li><strong>Per-transaction data</strong> comes from the platform database for every paid transaction: the task spec, the merged pull request URL, merge commit SHA, timestamps, reviewers, file/line counts, the Maya transaction reference, and the cardholder's accepted-and-merged action.</li>
        <li><strong>This static page</strong> renders the same template format. Pass <code>?taskId=&lt;id&gt;</code> to load the receipt for an in-platform transaction; pass <code>?pr=&lt;GitHub PR URL&gt;</code> to render a receipt populated live from GitHub's public API. Both produce the exact same field set.</li>
        <li><strong>Independently verifiable.</strong> Open the pull request URL on GitHub - same merge SHA, same merger, same timestamps. No PrTask account required.</li>
    </ol>
</section>
<script>
(function () {
    'use strict';
    var EXAMPLE_PR = 'https://github.com/cli/cli/pull/1';
    var form = document.getElementById('receipt-lookup');
    var input = document.getElementById('receipt-src');
    var submit = document.getElementById('receipt-submit');
    var example = document.getElementById('receipt-example');
    var statusEl = document.getElementById('receipt-status');
    var receipt = document.getElementById('receipt');
    var stamp = document.getElementById('receipt-stamp');
    var lastReceipt = null;
    function f(id) { return document.getElementById(id); }
    function setStatus(msg, kind) { statusEl.hidden = false; statusEl.className = 'receipt-status ' + (kind || ''); statusEl.textContent = msg; }
    function clearStatus() { statusEl.hidden = true; statusEl.className = 'receipt-status'; statusEl.textContent = ''; }
    function escapeHtml(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function fmtDate(iso) { if (!iso) return '-'; var d = new Date(iso); if (isNaN(d.getTime())) return iso; return d.toUTCString().replace('GMT', 'UTC'); }
    function parsePrUrl(raw) { if (!raw) return null; var m = raw.trim().match(/^https?:\/\/github\.com\/([^\/\s]+)\/([^\/\s]+)\/pull\/(\d+)(?:[\/?#]|$)/i); if (!m) return null; return { owner: m[1], repo: m[2].replace(/\.git$/i, ''), number: parseInt(m[3], 10) }; }
    function inferComplexity(pr) { var lines = (pr.additions || 0) + (pr.deletions || 0); if (lines < 50) return 'Simple'; if (lines < 200) return 'Medium'; if (lines < 1000) return 'Complex'; return 'Major'; }
    function userText(u) { if (!u || !u.login) return '-'; var html = ''; if (u.avatar_url) html += '<img src="' + u.avatar_url + '&s=40" alt="" style="width:18px;height:18px;border-radius:50%;vertical-align:middle;margin-right:6px" />'; html += '<a href="' + u.html_url + '" target="_blank" rel="noopener">@@' + escapeHtml(u.login) + '</a>'; return html; }
    async function fetchJson(url) { var r = await fetch(url, { headers: { 'Accept': 'application/vnd.github+json' } }); if (r.status === 404) throw new Error('Pull request not found, or the repository is private.'); if (r.status === 403) throw new Error('GitHub API rate limit hit. Wait a few minutes and try again.'); if (!r.ok) throw new Error('GitHub returned HTTP ' + r.status); return r.json(); }
    async function renderFromPr(parsed) {
        var base = 'https://api.github.com/repos/' + encodeURIComponent(parsed.owner) + '/' + encodeURIComponent(parsed.repo) + '/pulls/' + parsed.number;
        var pr = await fetchJson(base);
        var reviews = []; try { reviews = await fetchJson(base + '/reviews?per_page=100'); } catch (e) { reviews = []; }
        var state = pr.merged ? 'paid' : 'pending';
        stamp.className = 'receipt-stamp receipt-stamp-' + state;
        stamp.textContent = pr.merged ? 'Delivered & Accepted' : (pr.state === 'open' ? 'In Progress' : 'Closed (Not Merged)');
        f('r-receipt-number').textContent = 'PRT-' + parsed.owner + '-' + parsed.repo + '-' + parsed.number;
        f('r-maya-ref').textContent = pr.merged ? ('GH-' + (pr.merge_commit_sha || '').slice(0, 12)) : '-';
        f('r-issued-at').textContent = fmtDate(pr.merged_at || pr.updated_at);
        f('r-task-id').textContent = parsed.owner + '/' + parsed.repo + '#' + parsed.number;
        f('r-task-title').textContent = pr.title || '-';
        f('r-task-desc').textContent = pr.body ? (pr.body.length > 600 ? pr.body.slice(0, 600) + '...' : pr.body) : '-';
        f('r-repo-url').innerHTML = '<a href="https://github.com/' + escapeHtml(parsed.owner) + '/' + escapeHtml(parsed.repo) + '" target="_blank" rel="noopener">' + escapeHtml(parsed.owner + '/' + parsed.repo) + '</a>';
        f('r-complexity').textContent = inferComplexity(pr);
        f('r-client').innerHTML = pr.merged_by ? userText(pr.merged_by) : '-';
        f('r-developer').innerHTML = userText(pr.user);
        f('r-pr-id').textContent = '#' + pr.number;
        f('r-pr-url').innerHTML = '<a href="' + pr.html_url + '" target="_blank" rel="noopener">' + escapeHtml(pr.html_url) + '</a>';
        f('r-submitted').textContent = fmtDate(pr.created_at);
        f('r-merged').textContent = pr.merged_at ? fmtDate(pr.merged_at) : '-';
        f('r-sha').textContent = pr.merge_commit_sha || '-';
        f('r-base').textContent = (pr.base && pr.base.ref) || '-';
        f('r-files').textContent = (pr.changed_files != null) ? pr.changed_files : '-';
        f('r-lines').textContent = '+' + (pr.additions || 0) + ' / -' + (pr.deletions || 0);
        var box = f('r-reviewers'); box.innerHTML = ''; var seen = {}; var picks = []; var ordered = (reviews || []).slice().reverse();
        for (var i = 0; i < ordered.length; i++) { var rv = ordered[i]; if (!rv.user || !rv.user.login || seen[rv.user.login]) continue; seen[rv.user.login] = true; picks.push(rv); }
        picks.reverse();
        if (!picks.length) { box.textContent = pr.merged_by ? ('Merge action by @@' + pr.merged_by.login + ' constitutes acceptance.') : 'Merge action by cardholder constitutes acceptance.'; }
        else { picks.forEach(function (rv) { var st = (rv.state || '').toLowerCase().replace(/_/g, ' '); var html = '<span class="reviewer">'; if (rv.user.avatar_url) html += '<img src="' + rv.user.avatar_url + '&s=40" alt="" />'; html += '<a href="' + rv.user.html_url + '" target="_blank" rel="noopener">@@' + escapeHtml(rv.user.login) + '</a>'; html += ' <em>' + escapeHtml(st) + '</em></span> '; box.insertAdjacentHTML('beforeend', html); }); }
        f('r-amount').textContent = '-';
        f('r-fee').textContent = '-';
        f('r-net').textContent = '-';
        f('r-status').textContent = pr.merged ? 'Paid' : 'Pending';
        f('r-paid').textContent = pr.merged_at ? fmtDate(pr.merged_at) : '-';
        var ghLink = f('r-gh-link'); ghLink.href = pr.html_url; ghLink.hidden = false;
        lastReceipt = { receiptNumber: f('r-receipt-number').textContent, source: 'github', repository: parsed.owner + '/' + parsed.repo, pullRequest: pr.number, title: pr.title, state: state, author: pr.user ? pr.user.login : null, mergedBy: pr.merged_by ? pr.merged_by.login : null, submittedAt: pr.created_at, mergedAt: pr.merged_at, mergeCommitSha: pr.merge_commit_sha, baseBranch: pr.base ? pr.base.ref : null, changedFiles: pr.changed_files, additions: pr.additions, deletions: pr.deletions, htmlUrl: pr.html_url, receiptGeneratedAt: new Date().toISOString() };
        receipt.hidden = false; receipt.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    async function tryTaskId(taskId) { setStatus('Looking up PrTask transaction ' + taskId + '...', 'loading'); try { var r = await fetch('/api/tasks/' + encodeURIComponent(taskId)); if (!r.ok) throw new Error('Backend not yet attached. Use a GitHub PR URL to render the receipt with live independently-verifiable data.'); throw new Error('Loaded task; renderer for in-platform records pending backend.'); } catch (e) { throw e; } }
    form.addEventListener('submit', async function (e) {
        e.preventDefault(); clearStatus(); receipt.hidden = true;
        var raw = (input.value || '').trim();
        if (!raw) { setStatus('Paste a GitHub pull request URL or a PrTask task ID.', 'error'); return; }
        submit.disabled = true; submit.textContent = 'Rendering...';
        try { var pr = parsePrUrl(raw); if (pr) { setStatus('Fetching live data from GitHub for ' + pr.owner + '/' + pr.repo + ' #' + pr.number + '...', 'loading'); await renderFromPr(pr); clearStatus(); } else { await tryTaskId(raw); } }
        catch (err) { setStatus(err && err.message ? err.message : String(err), 'error'); }
        finally { submit.disabled = false; submit.textContent = 'Render Receipt'; }
    });
    example.addEventListener('click', function () { input.value = EXAMPLE_PR; form.dispatchEvent(new Event('submit', { cancelable: true })); });
    f('receipt-print').addEventListener('click', function () { window.print(); });
    f('receipt-copy').addEventListener('click', async function () { if (!lastReceipt) return; var json = JSON.stringify(lastReceipt, null, 2); try { await navigator.clipboard.writeText(json); var btn = f('receipt-copy'); var prev = btn.textContent; btn.textContent = 'Copied'; setTimeout(function () { btn.textContent = prev; }, 1500); } catch (e) { setStatus('Could not copy. Receipt JSON in console.', 'error'); console.log(json); } });
    var qs = new URLSearchParams(window.location.search);
    var initialPr = qs.get('pr'); var initialTask = qs.get('taskId');
    if (initialPr) { input.value = initialPr; form.dispatchEvent(new Event('submit', { cancelable: true })); }
    else if (initialTask) { input.value = initialTask; form.dispatchEvent(new Event('submit', { cancelable: true })); }
    else { input.value = EXAMPLE_PR; form.dispatchEvent(new Event('submit', { cancelable: true })); }
})();
</script>
